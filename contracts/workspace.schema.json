{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routefrom.local/contracts/workspace.schema.json",
  "title": "RouteFrom workspace contracts",
  "type": "object",
  "$defs": {
    "instant": {
      "type": "string",
      "format": "date-time"
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/instant" },
        "end": { "$ref": "#/$defs/instant" }
      }
    },
    "timeSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "ranges"],
      "properties": {
        "timezone": { "type": "string", "minLength": 1 },
        "ranges": {
          "type": "array",
          "items": { "$ref": "#/$defs/timeRange" }
        }
      }
    },
    "trajectoryDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pixelToleranceMeters": { "type": "number", "minimum": 0 },
        "vertexBudget": { "type": "integer", "minimum": 1 }
      }
    },
    "trajectoryVertex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordedAt", "coordinates", "isInterpolated", "anchorReasons"],
      "properties": {
        "recordedAt": { "$ref": "#/$defs/instant" },
        "coordinates": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 }
          ],
          "items": false
        },
        "sourcePointIndex": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
        },
        "importanceMeters": {
          "oneOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }]
        },
        "isInterpolated": { "type": "boolean" },
        "anchorReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "trajectoryPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectionRangeIndex",
        "segmentIndex",
        "selectedRange",
        "variantKind",
        "isInferred",
        "vertices"
      ],
      "properties": {
        "selectionRangeIndex": { "type": "integer", "minimum": 0 },
        "segmentIndex": { "type": "integer", "minimum": 0 },
        "selectedRange": { "$ref": "#/$defs/timeRange" },
        "variantKind": { "enum": ["cleaned_gps", "smoothed_gps", "map_matched"] },
        "isInferred": { "const": false },
        "appliedImportanceThresholdMeters": { "type": "number", "minimum": 0 },
        "vertices": {
          "type": "array",
          "items": { "$ref": "#/$defs/trajectoryVertex" }
        }
      }
    },
    "entityKind": {
      "enum": ["point", "gap", "visit", "trip", "leg", "place"]
    },
    "workspaceQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "processingRunId", "timeSelection"],
      "properties": {
        "datasetId": { "type": "string", "format": "uuid" },
        "processingRunId": {
          "oneOf": [
            { "const": "active" },
            { "type": "string", "format": "uuid" }
          ]
        },
        "timeSelection": { "$ref": "#/$defs/timeSelection" },
        "trajectoryDetail": { "$ref": "#/$defs/trajectoryDetail" },
        "spatialFilter": { "type": "object" },
        "entityKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/entityKind" }
        }
      }
    },
    "workspaceSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "logicalId", "source"],
      "properties": {
        "kind": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/entityKind" }]
        },
        "logicalId": {
          "oneOf": [{ "type": "null" }, { "type": "string", "format": "uuid" }]
        },
        "source": {
          "enum": [null, "map", "timeline", "search", "inspector"]
        }
      }
    },
    "timelineEvent": {
      "type": "object",
      "additionalProperties": true,
      "required": ["logicalId", "processingRunId", "kind", "observedRange", "confidence"],
      "properties": {
        "logicalId": { "type": "string", "format": "uuid" },
        "processingRunId": { "type": "string", "format": "uuid" },
        "kind": { "$ref": "#/$defs/entityKind" },
        "observedRange": { "$ref": "#/$defs/timeRange" },
        "possibleRange": { "$ref": "#/$defs/timeRange" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "qualityState": { "enum": ["valid", "suspect", "excluded", "unknown"] }
      }
    },
    "selectionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedDistanceMeters",
        "movingDurationSeconds",
        "confirmedStayDurationSeconds",
        "unknownDurationSeconds",
        "suspectPointCount",
        "gapCount",
        "inferredConnectionCount"
      ],
      "properties": {
        "observedDistanceMeters": { "type": "number", "minimum": 0 },
        "movingDurationSeconds": { "type": "number", "minimum": 0 },
        "confirmedStayDurationSeconds": { "type": "number", "minimum": 0 },
        "unknownDurationSeconds": { "type": "number", "minimum": 0 },
        "suspectPointCount": { "type": "integer", "minimum": 0 },
        "gapCount": { "type": "integer", "minimum": 0 },
        "inferredConnectionCount": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "query": { "$ref": "#/$defs/workspaceQuery" },
    "selection": { "$ref": "#/$defs/workspaceSelection" },
    "timelineEvents": {
      "type": "array",
      "items": { "$ref": "#/$defs/timelineEvent" }
    },
    "trajectoryPaths": {
      "type": "array",
      "items": { "$ref": "#/$defs/trajectoryPath" }
    },
    "summary": { "$ref": "#/$defs/selectionSummary" }
  }
}
