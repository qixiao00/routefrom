# Pooled Neon connection for short-lived server query requests.
DATABASE_URL=

# The processing worker and migrations use the direct URL outside Next.js.
DATABASE_URL_DIRECT=

# Website login. Use a random secret of at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000

# Temporary local-only guard until user authentication is implemented.
ROUTEFROM_ENABLE_LOCAL_DATA_API=false
ROUTEFROM_LOCAL_PREVIEW_PATH=
ROUTEFROM_ALLOWED_DATASET_ID=
