# Neon connection strings. Keep real credentials in .env.local only.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Website login; share the same secret/origin with the Next.js service.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000

# Private persistent storage shared by the website and Python worker.
# Set an absolute path on deployment, outside public/ and build outputs.
FOOTPRINT_DATA_DIR=
# Legacy local processing paths (not used by the website library queue).
FOOTPRINT_STORAGE=local
FOOTPRINT_RAW_DIR=./data/raw
FOOTPRINT_WORKING_DIR=./data/working
FOOTPRINT_GENERATED_DIR=./data/generated

# Optional offline map matching. Keep the URL loopback-only so private traces
# are never sent to a public routing service.
ROUTEFROM_VALHALLA_URL=http://127.0.0.1:8002
ROUTEFROM_MAP_SNAPSHOT_ID=
ROUTEFROM_MAP_SNAPSHOT_VERSION=
ROUTEFROM_MAP_DATASET_NAME=osm
