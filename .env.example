# Neon connection strings. Keep real credentials in .env.local only.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Temporary single-user API guard. Keep disabled until one dataset ID is set.
ROUTEFROM_ENABLE_LOCAL_DATA_API=false
ROUTEFROM_ALLOWED_DATASET_ID=

# Local development storage. Production uploads will use private object storage.
FOOTPRINT_STORAGE=local
FOOTPRINT_RAW_DIR=./data/raw
FOOTPRINT_WORKING_DIR=./data/working
FOOTPRINT_GENERATED_DIR=./data/generated
